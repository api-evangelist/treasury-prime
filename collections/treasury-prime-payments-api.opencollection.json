{
  "opencollection": "1.0.0",
  "info": {
    "name": "Treasury Prime Bank Accounts Payments API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "basic",
      "username": "{{username}}",
      "password": "{{password}}"
    }
